{
  "LedBarCam": {
    "BrokerHost": "homeassistant.local",
    "BrokerPort": 1883,
    "Username": "webcam-mqtt",
    "ClientId": "webcam-mqtt",
    "TopicBase": "webcam-mqtt",
    "DiscoveryPrefix": "homeassistant",
    "DeviceIdRegex": "^USB\\\\VID_046D&PID_[0-9A-F]{4}&MI_00\\\\",
    "PollMilliseconds": 1000,
    "OffDebounceSeconds": 5,
    "KeepAliveSeconds": 15,
    "EntityId": "binary_sensor.webcam_power",
    "DeviceName": "Webcam Monitor"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    },
    "EventLog": {
      "SourceName": "LedBarCam",
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning"
      }
    }
  }
}